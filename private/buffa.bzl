"""Rules for building protos in Rust with buffa."""

load("@rules_cc//cc:find_cc_toolchain.bzl", "use_cc_toolchain")
load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
load("@rules_proto//proto:defs.bzl", "ProtoInfo")
load("@rules_rust//rust:defs.bzl", "rust_analyzer_aspect", "rust_common")

# buildifier: disable=bzl-visibility
load("@rules_rust//rust/private:providers.bzl", "RustAnalyzerGroupInfo", "RustAnalyzerInfo")

# buildifier: disable=bzl-visibility
load("@rules_rust//rust/private:rust.bzl", "RUSTC_ATTRS")

# buildifier: disable=bzl-visibility
load("@rules_rust//rust/private:rust_analyzer.bzl", "write_rust_analyzer_spec_file")

# buildifier: disable=bzl-visibility
load("@rules_rust//rust/private:rustc.bzl", "rustc_compile_action")

# buildifier: disable=bzl-visibility
load(
    "@rules_rust//rust/private:utils.bzl",
    "can_build_metadata",
    "can_use_metadata_for_pipelining",
    "generate_output_diagnostics",
)

RUST_EDITION = "2021"

TOOLCHAIN_TYPE = "@rules_buffa//:toolchain_type"

BuffaProtoInfo = provider(
    doc = "Rust crates generated by buffa for a `proto_library`.",
    fields = {
        "dep_variant_infos": "list[DepVariantInfo]: The crates dependents compile against: this target's and its `exports`', or its deps' if it has no srcs.",
        "rust_analyzer_infos": "list[RustAnalyzerInfo]: The rust-analyzer crate metadata matching `dep_variant_infos`.",
        "transitive_dep_infos": "depset[DepVariantInfo]: The toolchain runtime and all transitive proto dep crates, used when the toolchain enables `include_transitive_deps`.",
        "transitive_manifests": "depset[File]: Extern path manifests of this target and its transitive deps.",
    },
)

BuffaTransformInfo = provider(
    doc = "Per-`proto_library` adjustments to the crate buffa generates.",
    fields = {
        "crate_features": "list[str]: Additional crate features enabled on the generated crate.",
        "crate_name": "str: Crate name override, or None.",
        "deps": "list[DepVariantInfo]: Additional dependencies of the generated crate.",
        "opts": "list[str]: Additional codegen options.",
        "srcs": "depset[File]: Additional sources appended to the generated crate root.",
    },
)

def _get_crate_info(providers):
    """Finds the CrateInfo provider in the list of providers."""
    for provider in providers:
        if hasattr(provider, "name"):
            return provider
    fail("Couldn't find a CrateInfo in the list of providers")

def _get_dep_info(providers):
    """Finds the DepInfo provider in the list of providers."""
    for provider in providers:
        if hasattr(provider, "direct_crates"):
            return provider
    fail("Couldn't find a DepInfo in the list of providers")

def _get_cc_info(providers):
    """Finds the CcInfo provider in the list of providers."""
    for provider in providers:
        if hasattr(provider, "linking_context"):
            return provider
    fail("Couldn't find a CcInfo in the list of providers")

def _compile_rust(
        *,
        ctx,
        attr,
        crate_name,
        src,
        deps,
        edition,
        rust_flags):
    """Compiles a Rust source file.

    Args:
      ctx (RuleContext): The rule context.
      attr (Attrs): The current rule's attributes (`ctx.attr` for rules, `ctx.rule.attr` for aspects)
      crate_name (str): The crate module name to use.
      src (File): The crate root source file to be compiled.
      deps (List of DepVariantInfo): A list of dependencies needed.
      edition (str): The Rust edition to use.
      rust_flags (List of str): Additional flags to pass to rustc.

    Returns:
      A DepVariantInfo provider.
    """
    toolchain = ctx.toolchains["@rules_rust//rust:toolchain_type"]
    output_hash = repr(hash(src.path + ".buffa"))

    lib_name = "{prefix}{name}-{lib_hash}{extension}".format(
        prefix = "lib",
        name = crate_name,
        lib_hash = output_hash,
        extension = ".rlib",
    )

    rmeta_name = "{prefix}{name}-{lib_hash}{extension}".format(
        prefix = "lib",
        name = crate_name,
        lib_hash = output_hash,
        extension = ".rmeta",
    )

    lib = ctx.actions.declare_file(lib_name)
    rmeta = None
    rustc_rmeta_output = None
    metadata_supports_pipelining = False

    if can_build_metadata(toolchain, ctx, "rlib"):
        rmeta_name = "{prefix}{name}-{lib_hash}{extension}".format(
            prefix = "lib",
            name = crate_name,
            lib_hash = output_hash,
            extension = ".rmeta",
        )
        rmeta = ctx.actions.declare_file(rmeta_name)
        rustc_rmeta_output = generate_output_diagnostics(ctx, rmeta)
        metadata_supports_pipelining = can_use_metadata_for_pipelining(toolchain, "rlib")

    providers = rustc_compile_action(
        ctx = ctx,
        attr = attr,
        toolchain = toolchain,
        crate_info_dict = dict(
            name = crate_name,
            type = "rlib",
            root = src,
            srcs = [src],
            deps = deps,
            proc_macro_deps = [],
            aliases = {},
            output = lib,
            metadata = rmeta,
            metadata_supports_pipelining = metadata_supports_pipelining,
            rustc_rmeta_output = rustc_rmeta_output,
            edition = edition,
            is_test = False,
            rustc_env = {},
            compile_data = depset([]),
            compile_data_targets = depset([]),
            owner = ctx.label,
        ),
        output_hash = output_hash,
        rust_flags = rust_flags,
    )

    crate_info = _get_crate_info(providers)
    dep_info = _get_dep_info(providers)
    cc_info = _get_cc_info(providers)

    return rust_common.dep_variant_info(
        crate_info = crate_info,
        dep_info = dep_info,
        cc_info = cc_info,
        build_info = None,
    )

def _rust_buffa_aspect_impl(target, ctx):
    buffa_toolchain = ctx.toolchains[TOOLCHAIN_TYPE]

    dep_infos = [dep[BuffaProtoInfo] for dep in getattr(ctx.rule.attr, "deps", [])]
    dep_variant_infos = [
        dep_variant_info
        for dep_info in dep_infos
        for dep_variant_info in dep_info.dep_variant_infos
    ]
    dep_rust_analyzer_infos = [
        rust_analyzer_info
        for dep_info in dep_infos
        for rust_analyzer_info in dep_info.rust_analyzer_infos
    ]

    proto_info = target[ProtoInfo]
    if not proto_info.direct_sources:
        # A `proto_library` with no srcs just forwards its deps.
        return [BuffaProtoInfo(
            dep_variant_infos = dep_variant_infos,
            rust_analyzer_infos = dep_rust_analyzer_infos,
            transitive_dep_infos = depset(transitive = [
                dep_info.transitive_dep_infos
                for dep_info in dep_infos
            ]),
            transitive_manifests = depset(transitive = [
                dep_info.transitive_manifests
                for dep_info in dep_infos
            ]),
        )]

    transform_infos = [
        data[BuffaTransformInfo]
        for data in getattr(ctx.rule.attr, "data", [])
        if BuffaTransformInfo in data
    ]
    crate_name_overrides = [
        info.crate_name
        for info in transform_infos
        if info.crate_name
    ]
    if len(crate_name_overrides) > 1:
        fail("Multiple crate name overrides detected. Only one override is allowed. Please check your rust_buffa_transform targets.")
    crate_name = crate_name_overrides[0] if crate_name_overrides else ctx.label.name.replace("-", "_").replace("/", "_")

    export_infos = [
        export[BuffaProtoInfo]
        for export in getattr(ctx.rule.attr, "exports", [])
    ]
    crate_features = buffa_toolchain.crate_features + [
        feature
        for info in transform_infos
        for feature in info.crate_features
    ]

    lib_rs = ctx.actions.declare_file("{}.buffa.rs".format(ctx.label.name))
    manifest = ctx.actions.declare_file("{}.buffa_extern_paths".format(ctx.label.name))

    dep_manifests = depset(transitive = [
        dep_info.transitive_manifests
        for dep_info in dep_infos
    ])

    args = ctx.actions.args()
    args.add(crate_name)
    args.add(lib_rs)
    args.add(manifest)
    args.add(proto_info.direct_descriptor_set)

    deps_args = ctx.actions.args()
    deps_args.set_param_file_format("multiline")
    deps_args.add_all(dep_manifests)
    deps_args.use_param_file("%s", use_always = True)

    sets_args = ctx.actions.args()
    sets_args.set_param_file_format("multiline")
    sets_args.add_all(proto_info.transitive_descriptor_sets)
    sets_args.use_param_file("%s", use_always = True)

    transform_srcs = depset(transitive = [
        info.srcs
        for info in transform_infos
    ])

    srcs_args = ctx.actions.args()
    srcs_args.set_param_file_format("multiline")
    srcs_args.add_all(transform_srcs)
    srcs_args.use_param_file("%s", use_always = True)

    # The generated crate root re-exports the crates it compiles against so
    # dependents can also reach them as `<crate>::<dep_crate>::...`.
    reexports = {}  # crate name -> label of the proto_library that generates it
    for dep_variant_info in dep_variant_infos:
        crate_info = dep_variant_info.crate_info
        owner = reexports.setdefault(crate_info.name, crate_info.owner)
        if owner != crate_info.owner:
            fail("{} and {} both generate a crate named `{}`, so {} cannot depend on both. Give one a distinct `crate_name` with a `rust_buffa_transform` in its `data`.".format(owner, crate_info.owner, crate_info.name, ctx.label))

    reexports_args = ctx.actions.args()
    reexports_args.set_param_file_format("multiline")
    reexports_args.add_all(reexports.keys())
    reexports_args.use_param_file("%s", use_always = True)

    opts_args = ctx.actions.args()
    opts_args.add_all(buffa_toolchain.opts + [
        opt
        for info in transform_infos
        for opt in info.opts
    ])

    ctx.actions.run(
        executable = buffa_toolchain.codegen,
        arguments = [args, deps_args, sets_args, srcs_args, reexports_args, opts_args],
        inputs = depset(
            [proto_info.direct_descriptor_set],
            transitive = [
                dep_manifests,
                proto_info.transitive_descriptor_sets,
                transform_srcs,
            ],
        ),
        outputs = [lib_rs, manifest],
        mnemonic = "BuffaGenProto",
        progress_message = "Generating buffa Rust source for %{label}",
    )

    dep_variant_info = _compile_rust(
        ctx = ctx,
        attr = ctx.rule.attr,
        crate_name = crate_name,
        src = lib_rs,
        deps = buffa_toolchain.runtime + dep_variant_infos + [
            dep
            for info in transform_infos
            for dep in info.deps
        ],
        edition = RUST_EDITION,
        rust_flags = [
            flag
            for feature in crate_features
            for flag in ["--cfg", 'feature="{}"'.format(feature)]
        ],
    )

    # Always add `test` & `debug_assertions`. See rust-analyzer source code:
    # https://github.com/rust-analyzer/rust-analyzer/blob/2021-11-15/crates/project_model/src/workspace.rs#L529-L531
    cfgs = ["test", "debug_assertions"] + [
        'feature="{}"'.format(feature)
        for feature in crate_features
    ]

    rust_analyzer_deps = buffa_toolchain.rust_analyzer_infos + dep_rust_analyzer_infos
    rust_analyzer_info = write_rust_analyzer_spec_file(ctx, ctx.rule.attr, ctx.label, RustAnalyzerInfo(
        aliases = {},
        crate = dep_variant_info.crate_info,
        cfgs = cfgs,
        env = dep_variant_info.crate_info.rustc_env,
        deps = rust_analyzer_deps,
        crate_specs = depset(transitive = [dep.crate_specs for dep in rust_analyzer_deps]),
        proc_macro_dylibs = depset(transitive = [dep.proc_macro_dylibs for dep in rust_analyzer_deps]),
        build_info_out_dirs = depset(transitive = [dep.build_info_out_dirs for dep in rust_analyzer_deps]),
        proc_macro_dylib = None,
        build_info = None,
    ))

    return [
        BuffaProtoInfo(
            dep_variant_infos = [dep_variant_info] + [
                info
                for export_info in export_infos
                for info in export_info.dep_variant_infos
            ],
            rust_analyzer_infos = [rust_analyzer_info] + [
                info
                for export_info in export_infos
                for info in export_info.rust_analyzer_infos
            ],
            transitive_dep_infos = depset(transitive = [depset(buffa_toolchain.runtime)] + [
                depset(
                    dep_info.dep_variant_infos,
                    transitive = [dep_info.transitive_dep_infos],
                )
                for dep_info in dep_infos
            ]),
            transitive_manifests = depset(
                [manifest],
                transitive = [dep_manifests],
            ),
        ),
        rust_analyzer_info,
    ]

rust_buffa_aspect = aspect(
    doc = "An aspect used to generate and compile proto files with buffa.",
    implementation = _rust_buffa_aspect_impl,
    attr_aspects = ["deps", "exports"],
    attrs = {
        "_collect_cc_coverage": attr.label(
            default = Label("@rules_rust//rust/coverage:collect_rust_coverage"),
            executable = True,
            cfg = "exec",
        ),
    } | RUSTC_ATTRS | {
        # Need to override this attribute to explicitly set the workspace.
        "_always_enable_metadata_output_groups": attr.label(
            default = Label("@rules_rust//rust/settings:always_enable_metadata_output_groups"),
        ),
    },
    fragments = ["cpp"],
    toolchains = [
        TOOLCHAIN_TYPE,
    ] + use_cc_toolchain(mandatory = False) + [
        "@rules_rust//rust:toolchain_type",
    ],
)

def _rust_buffa_library_impl(ctx):
    info = ctx.attr.proto[BuffaProtoInfo]

    transitive = []
    if ctx.toolchains[TOOLCHAIN_TYPE].include_transitive_deps:
        transitive = [info.transitive_dep_infos]

    return [
        DefaultInfo(files = depset([i.crate_info.output for i in info.dep_variant_infos])),
        OutputGroupInfo(buffa_srcs = depset([i.crate_info.root for i in info.dep_variant_infos])),
        rust_common.crate_group_info(
            dep_variant_infos = depset(
                info.dep_variant_infos,
                transitive = transitive,
            ),
        ),
        RustAnalyzerGroupInfo(deps = info.rust_analyzer_infos),
    ]

rust_buffa_library = rule(
    doc = "A rule for generating a Rust library using buffa. The `buffa_srcs` output group contains the generated crate roots, so other tooling, e.g. a Cargo `build.rs`, can consume the exact source Bazel compiles.",
    implementation = _rust_buffa_library_impl,
    attrs = {
        "proto": attr.label(
            doc = "A `proto_library` target for which to generate Rust gencode.",
            providers = [ProtoInfo],
            aspects = [rust_buffa_aspect],
            mandatory = True,
        ),
    },
    toolchains = [TOOLCHAIN_TYPE],
    provides = [
        rust_common.crate_group_info,
    ],
)

def _rust_buffa_toolchain_impl(ctx):
    return [platform_common.ToolchainInfo(
        codegen = ctx.attr.codegen[DefaultInfo].files_to_run,
        crate_features = ctx.attr.crate_features,
        include_transitive_deps = ctx.attr.include_transitive_deps,
        opts = ctx.attr.opts,
        rust_analyzer_infos = [
            target[RustAnalyzerInfo]
            for target in ctx.attr.runtime
            if RustAnalyzerInfo in target
        ],
        runtime = [
            rust_common.dep_variant_info(
                crate_info = target[rust_common.crate_info],
                dep_info = target[rust_common.dep_info],
                cc_info = target[CcInfo] if CcInfo in target else None,
                build_info = None,
            )
            for target in ctx.attr.runtime
        ],
    )]

rust_buffa_toolchain = rule(
    implementation = _rust_buffa_toolchain_impl,
    doc = "Rust buffa toolchain rule.",
    attrs = {
        "codegen": attr.label(
            doc = "The buffa codegen binary to invoke.",
            cfg = "exec",
            executable = True,
            mandatory = True,
        ),
        "crate_features": attr.string_list(
            doc = "Crate features enabled on every generated crate, needed by codegen options that gate generated code on crate features: `arbitrary=true` always emits `#[cfg_attr(feature = \"arbitrary\", ...)]`, and `gate_impls=true` gates the `json`, `views`, `text`, and `reflect` impls on the corresponding `*_feature` names.",
        ),
        "include_transitive_deps": attr.bool(
            doc = "Whether to include transitive dependencies. If set to True, all transitive dependencies will directly accessible by the dependent crate.",
            default = False,
        ),
        "opts": attr.string_list(
            doc = "Codegen options as `key=value`, e.g. `json=true`. See the `rules_buffa` module documentation for the supported keys.",
        ),
        "runtime": attr.label_list(
            doc = "The crates generated code links against, normally `buffa`, `buffa-types`, and `buffa-descriptor`.",
            providers = [rust_common.crate_info],
            aspects = [rust_analyzer_aspect],
            mandatory = True,
        ),
    },
)

def _rust_buffa_transform_impl(ctx):
    deps = []
    for target in ctx.attr.deps:
        deps.append(rust_common.dep_variant_info(
            crate_info = target[rust_common.crate_info],
            dep_info = target[rust_common.dep_info],
            cc_info = target[CcInfo] if CcInfo in target else None,
            build_info = None,
        ))

    # DefaultInfo is intentionally not returned here to avoid impacting other
    # consumers of the `proto_library` target this rule is expected to be passed
    # to.
    return [BuffaTransformInfo(
        crate_features = ctx.attr.crate_features,
        crate_name = ctx.attr.crate_name if ctx.attr.crate_name else None,
        deps = deps,
        opts = ctx.attr.opts,
        srcs = depset(ctx.files.srcs),
    )]

rust_buffa_transform = rule(
    doc = """\
A rule for transforming the outputs of `BuffaGenProto` actions.

This rule is used by adding it to the `data` attribute of `proto_library` targets. E.g.
```python
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_buffa//:defs.bzl", "rust_buffa_library", "rust_buffa_transform")

rust_buffa_transform(
    name = "a_transform",
    srcs = [
        "a_src.rs",
    ],
)

proto_library(
    name = "a_proto",
    srcs = [
        "a.proto",
    ],
    data = [
        ":a_transform",
    ],
)

rust_buffa_library(
    name = "a_rs_buffa",
    proto = ":a_proto",
)
```

The `rust_buffa_library` will spawn an action on the `a_proto` target which consumes the
`a_transform` rule to provide a means of granularly modifying a proto library for `BuffaGenProto`
actions with minimal impact to other consumers.
""",
    implementation = _rust_buffa_transform_impl,
    attrs = {
        "crate_features": attr.string_list(
            doc = "Additional crate features enabled on the generated crate; see `rust_buffa_toolchain`'s `crate_features`.",
        ),
        "crate_name": attr.string(
            doc = "The name of the crate generated by buffa. This is used to override the default name which is the name of the proto_library target.",
            mandatory = False,
        ),
        "deps": attr.label_list(
            doc = "Additional dependencies to add to the compiled crate.",
            providers = [rust_common.crate_info],
        ),
        "opts": attr.string_list(
            doc = "Additional codegen options; see `rust_buffa_toolchain`'s `opts`.",
        ),
        "srcs": attr.label_list(
            doc = "Additional source files to include in the generated crate root.",
            allow_files = True,
        ),
    },
)
