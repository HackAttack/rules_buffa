load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust//crate_universe:defs.bzl", "crate", "crates_vendor")

crates_vendor(
    name = "crates_vendor",
    cargo_lockfile = "Cargo.Bazel.lock",
    mode = "remote",
    # Every feature of the runtime crates, so every codegen option and
    # runtime API works with the default toolchain. Generated code names
    # `arbitrary` and `serde`, and the `buffa-types` conversions name `chrono`
    # and `jiff`, so those are vendored directly to give them labels.
    packages = {
        "arbitrary": crate.spec(
            version = "1",
        ),
        "buffa": crate.spec(
            features = [
                "arbitrary",
                "json",
                "text",
            ],
            version = "=0.9.2",
        ),
        "buffa-codegen": crate.spec(
            version = "=0.9.2",
        ),
        "buffa-descriptor": crate.spec(
            features = [
                "arbitrary",
                "json",
                "reflect",
                "text",
                "views",
            ],
            version = "=0.9.2",
        ),
        "buffa-types": crate.spec(
            features = [
                "arbitrary",
                "chrono",
                "jiff",
                "json",
                "reflect",
            ],
            version = "=0.9.2",
        ),
        "chrono": crate.spec(
            version = "0.4.34",
        ),
        "connectrpc": crate.spec(
            default_features = False,
            features = ["json"],
            version = "=0.9.1",
        ),
        "connectrpc-codegen": crate.spec(
            version = "=0.9.0",
        ),
        "futures": crate.spec(
            features = ["executor"],
            version = "0.3",
        ),
        "jiff": crate.spec(
            version = "0.2",
        ),
        "serde": crate.spec(
            version = "1",
        ),
    },
    # Shorten the repository name to avoid MAX_PATH issues on Windows
    # `rules_buffa_deps` == `rbd`
    repository_name = "rbd",
    tags = ["manual"],
)

bzl_library(
    name = "bzl_lib",
    srcs = [
        "//private/3rdparty/crates:crates.bzl",
        "//private/3rdparty/crates:defs.bzl",
    ],
    visibility = ["//private:__pkg__"],
)
