load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//private:buffa.bzl", "rust_buffa_toolchain")

# `arbitrary` and `serde` are named by the code `arbitrary=true` and
# `json=true` generate.
rust_buffa_toolchain(
    name = "default_buffa_toolchain_impl",
    codegen = "//:codegen",
    runtime = [
        "//private/3rdparty/crates:arbitrary",
        "//private/3rdparty/crates:buffa",
        "//private/3rdparty/crates:buffa-descriptor",
        "//private/3rdparty/crates:buffa-types",
        "//private/3rdparty/crates:serde",
    ],
)

rust_buffa_toolchain(
    name = "connect_buffa_toolchain_impl",
    codegen = "//:connect_codegen",
    runtime = [
        "//private/3rdparty/crates:arbitrary",
        "//private/3rdparty/crates:buffa",
        "//private/3rdparty/crates:buffa-descriptor",
        "//private/3rdparty/crates:buffa-types",
        "//private/3rdparty/crates:connectrpc",
        "//private/3rdparty/crates:serde",
    ],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["**/*.bzl"]),
    visibility = ["//:__pkg__"],
    deps = [
        "//private/3rdparty:bzl_lib",
        "@rules_proto//proto:defs",
        "@rules_rust//rust:bzl_lib",
    ],
)
