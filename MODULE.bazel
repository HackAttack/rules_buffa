"""Bazel rules for building protos in Rust with buffa"""

module(
    name = "rules_buffa",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "28.3", repo_name = "com_google_protobuf")

bazel_dep(name = "googleapis", version = "0.0.0-20241220-5e258e33.bcr.1", dev_dependency = True, repo_name = "com_google_googleapis")

rust_ext = use_extension("//:extensions.bzl", "rust_ext")
use_repo(
    rust_ext,
    "rbd",
    "rbd__arbitrary-1.5.0",
    "rbd__buffa-0.9.2",
    "rbd__buffa-codegen-0.9.2",
    "rbd__buffa-descriptor-0.9.2",
    "rbd__buffa-types-0.9.2",
    "rbd__chrono-0.4.45",
    "rbd__connectrpc-0.9.1",
    "rbd__connectrpc-codegen-0.9.0",
    "rbd__futures-0.3.34",
    "rbd__jiff-0.2.46",
    "rbd__serde-1.0.229",
)

register_toolchains(
    "//:default_buffa_toolchain",
)
